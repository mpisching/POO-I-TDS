               </GridPane.margin></Label>
            <TextField fx:id="tfNome" prefHeight="26.0" prefWidth="277.0" GridPane.columnIndex="1" />
            <TextField fx:id="tfIdade" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="tfPeso" prefHeight="128.0" prefWidth="331.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="tfAltura" prefHeight="0.0" prefWidth="298.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <Button layoutX="484.0" layoutY="222.0" mnemonicParsing="false" onAction="#onActionBTLimpar" text="Limpar" />
      <Button layoutX="418.0" layoutY="222.0" mnemonicParsing="false" onAction="#onActionBTOk" prefHeight="26.0" prefWidth="55.0" text="Ok" />
      <Label layoutX="185.0" layoutY="14.0" text="Calculadora de IMC" textFill="#000cb2">
