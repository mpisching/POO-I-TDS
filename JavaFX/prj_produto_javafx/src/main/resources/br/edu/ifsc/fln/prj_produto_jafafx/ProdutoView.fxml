<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="195.0" prefWidth="467.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifsc.fln.controller.ProdutoController">
   <children>
      <GridPane layoutX="75.0" layoutY="44.0" prefHeight="90.0" prefWidth="372.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="181.0" minWidth="10.0" prefWidth="67.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="305.0" minWidth="10.0" prefWidth="305.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label prefHeight="17.0" prefWidth="189.0" text="Nome:" />
            <Label text="Preço:" GridPane.rowIndex="1" />
            <Label text="Desconto:" GridPane.rowIndex="2" />
            <TextField fx:id="tfNome" GridPane.columnIndex="1" />
            <TextField fx:id="tfPreco" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="tfDesconto" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <Button layoutX="322.0" layoutY="148.0" mnemonicParsing="false" onAction="#onActionBtOk" prefHeight="25.0" prefWidth="53.0" text="Ok" />
      <Button layoutX="395.0" layoutY="148.0" mnemonicParsing="false" onAction="#onActionBtLimpar" text="Limpar" />
      <Label alignment="CENTER" layoutX="-2.0" layoutY="14.0" prefHeight="17.0" prefWidth="467.0" text="Calculadora de preço de produto" textFill="#3719bf">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
